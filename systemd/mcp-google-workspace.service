[Unit]
Description=Google Workspace MCP Server (Streamable HTTP, 127.0.0.1:7804)
After=network.target
# StartLimit* belong in [Unit], not [Service] — modern systemd ignores them there.
StartLimitIntervalSec=60
StartLimitBurst=10

[Service]
Type=simple
WorkingDirectory=%h/.claude/mcp-servers/google-workspace
ExecStart=/usr/bin/node %h/.claude/mcp-servers/google-workspace/dist/index.js
Environment=MCP_TRANSPORT=http
Environment=MCP_PORT=7804
Environment=NODE_ENV=production
# No env secret for this one: OAuth client credentials, tokens.json and the mail
# signature all resolve under this directory.
Environment=MCP_CREDENTIALS_PATH=%h/.claude/mcp-credentials
Restart=always
RestartSec=3
# googleapis is by far the heaviest dependency of the four — 512M, not 256M.
MemoryHigh=384M
MemoryMax=512M
# Must be 0, not negative: a systemd *user* unit has no CAP_SYS_RESOURCE and would
# fail to start. Real protection against earlyoom comes from `node` being in its
# --avoid regex — which is also why this process must NOT be renamed away from `node`.
OOMScoreAdjust=0
SyslogIdentifier=mcp-google-workspace

[Install]
WantedBy=default.target
