[Unit]
Description=OpenDia Dashboard (Express + SQLite)
After=network.target

[Service]
Type=simple
WorkingDirectory=/home/linnflux/OpenDia/repo/dashboard
ExecStart=/usr/bin/node server/index.js
Restart=always
RestartSec=5
StartLimitBurst=5
StartLimitIntervalSec=60
MemoryHigh=1G
MemoryMax=2G
EnvironmentFile=/home/linnflux/OpenDia/repo/dashboard/.env

[Install]
WantedBy=default.target
